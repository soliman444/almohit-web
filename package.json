{
  "name": "almohit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 8069",
    "build": "next build",
    "start": "next start -p 8069",
    "lint": "eslint .",
    "test": "tsx --test src/lib/money.test.ts src/lib/commerce-rules.test.ts src/lib/variant-rules.test.ts src/lib/currency.test.ts src/lib/currency-rules.test.ts src/lib/media-system.test.ts src/lib/storefront-filters.test.ts",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate": "prisma migrate dev --config prisma7.config.ts",
    "db:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "db:studio": "prisma studio --config prisma7.config.ts",
    "db:seed": "prisma migrate deploy --config prisma7.config.ts && tsx prisma/seed.ts",
    "db:setup": "prisma migrate deploy --config prisma7.config.ts && tsx prisma/seed.ts",
    "postinstall": "prisma generate --config prisma7.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
