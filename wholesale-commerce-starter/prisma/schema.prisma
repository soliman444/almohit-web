generator client {
  provider = "prisma-client"
  output   = "../packages/database/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum BusinessStatus {
  NORMAL
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum BusinessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductType {
  SIMPLE
  VARIABLE
}

enum AttributeType {
  TEXT
  COLOR
  SELECT
}

enum VariantStatus {
  ACTIVE
  INACTIVE
}

enum PriceGroupStatus {
  ACTIVE
  INACTIVE
}

enum MediaFileType {
  IMAGE
  VIDEO
  IMAGE_360
  DOCUMENT
}

enum ProductMediaRole {
  MAIN
  GALLERY
  VIDEO
  VIEW_360
}

enum MediaFitMode {
  AUTO
  COVER
  CONTAIN
}
enum IntegrationJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}
enum IntegrationJobType {
  ODOO_CUSTOMER_SYNC
  ODOO_INVOICE_SYNC
}
model IntegrationJob {
  id               String               @id @default(cuid())
  type             IntegrationJobType
  entityId         String               @map("entity_id")
  dedupeKey        String               @unique @map("dedupe_key")
  status           IntegrationJobStatus @default(PENDING)

  attempts         Int                  @default(0)
  maxAttempts      Int                  @default(8) @map("max_attempts")
  nextAttemptAt    DateTime             @default(now()) @map("next_attempt_at")

  lockedAt         DateTime?            @map("locked_at")
  lockedBy         String?              @map("locked_by")

  lastErrorCode    String?              @map("last_error_code")
  lastErrorMessage String?              @map("last_error_message")

  processedAt      DateTime?            @map("processed_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt])
  @@index([type, entityId])
  @@map("integration_jobs")
}
model User {
  id              String      @id @default(cuid())
  name            String
  email           String?     @unique
  phone           String?     @unique
  passwordHash    String      @map("password_hash")
  status          UserStatus  @default(ACTIVE)
  emailVerifiedAt DateTime?   @map("email_verified_at")
  phoneVerifiedAt DateTime?   @map("phone_verified_at")
  lastLoginAt     DateTime?   @map("last_login_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  deletedAt       DateTime?   @map("deleted_at")

  roles            UserRole[]
  customer         Customer?
  reviewedRequests BusinessRequest[] @relation("BusinessRequestReviewer")
  createdProducts  Product[] @relation("ProductCreatedBy")
  updatedProducts  Product[] @relation("ProductUpdatedBy")
  createdMedia     Media[]   @relation("MediaCreatedBy")
  orderStatusChanges OrderStatusHistory[]
  auditLogs        AuditLog[]
  sessions         Session[]

  @@index([status])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Customer {
  id             String         @id @default(cuid())
  userId         String         @unique @map("user_id")
  customerCode   String         @unique @map("customer_code")
  businessStatus BusinessStatus @default(NORMAL) @map("business_status")
  companyName    String?        @map("company_name")
  businessName   String?        @map("business_name")
  taxNumber      String?        @map("tax_number")
  priceGroupId   String?        @map("price_group_id")
  notes          String?
  odooPartnerId  Int? @map("odoo_partner_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  priceGroup       PriceGroup?       @relation(fields: [priceGroupId], references: [id], onDelete: SetNull)
  businessRequests BusinessRequest[]
  addresses        Address[]
  carts            Cart[]
  orders           Order[]

  @@index([businessStatus])
  @@index([priceGroupId])
  @@map("customers")
}

model BusinessRequest {
  id              String                @id @default(cuid())
  customerId      String                @map("customer_id")
  businessName    String                @map("business_name")
  businessType    String?               @map("business_type")
  city            String?
  address         String?
  phone           String?
  notes           String?
  status          BusinessRequestStatus @default(PENDING)
  reviewedById    String?               @map("reviewed_by")
  reviewedAt      DateTime?             @map("reviewed_at")
  rejectionReason String?               @map("rejection_reason")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reviewer User?    @relation("BusinessRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([customerId, status])
  @@index([status, createdAt])
  @@map("business_requests")
}

model Category {
  id             String    @id @default(cuid())
  parentId       String?   @map("parent_id")
  name           String
  slug           String    @unique
  description    String?
  heroVideoUrl   String?   @map("hero_video_url")
  heroPosterUrl  String?   @map("hero_poster_url")
  heroFocalX     Float     @default(50) @map("hero_focal_x")
  heroFocalY     Float     @default(50) @map("hero_focal_y")
  heroScale      Float     @default(1) @map("hero_scale")
  status         Boolean   @default(true)
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId, sortOrder])
  @@index([status])
  @@map("categories")
}

model Brand {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  status      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  products Product[]

  @@index([status])
  @@map("brands")
}

model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  sku              String        @unique
  shortDescription String?       @map("short_description")
  description      String?
  categoryId       String        @map("category_id")
  brandId          String?       @map("brand_id")
  productType      ProductType   @default(SIMPLE) @map("product_type")
  status           ProductStatus @default(DRAFT)
  isFeatured       Boolean       @default(false) @map("is_featured")
  isNew            Boolean       @default(false) @map("is_new")
  minOrderQuantity Int           @default(1) @map("min_order_quantity")
  createdById      String?       @map("created_by")
  updatedById      String?       @map("updated_by")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")

  category  Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand     Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?    @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  prices         Price[]
  media          ProductMedia[]
  inventory      Inventory?
  cartItems      CartItem[]
  orderItems     OrderItem[]
  attributes     ProductAttribute[]
  allowedValues  ProductAllowedValue[]
  variants       ProductVariant[]

  @@index([categoryId, status])
  @@index([brandId])
  @@index([isFeatured, status])
  @@map("products")
}

model Media {
  id          String        @id @default(cuid())
  fileName    String        @map("file_name")
  filePath    String        @map("file_path")
  fileType    MediaFileType @map("file_type")
  mimeType    String?       @map("mime_type")
  fileSize    Int?          @map("file_size")
  width       Int?
  height      Int?
  altText     String?       @map("alt_text")
  createdById String?       @map("created_by")
  createdAt   DateTime      @default(now()) @map("created_at")

  createdBy    User?          @relation("MediaCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  productMedia ProductMedia[]

  @@index([fileType])
  @@map("media")
}

model ProductMedia {
  id         String           @id @default(cuid())
  productId  String           @map("product_id")
  mediaId    String           @map("media_id")
  type       ProductMediaRole
  sortOrder  Int              @default(0) @map("sort_order")
  isPrimary   Boolean      @default(false) @map("is_primary")
  fitMode     MediaFitMode @default(AUTO) @map("fit_mode")
  focalX      Float        @default(50) @map("focal_x")
  focalY      Float        @default(50) @map("focal_y")
  visualScale Float        @default(1) @map("visual_scale")
  createdAt   DateTime     @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([productId, type, sortOrder])
  @@map("product_media")
}

model Inventory {
  id               String   @id @default(cuid())
  productId        String?  @unique @map("product_id")
  variantId        String?  @unique @map("variant_id")
  quantity         Int      @default(0)
  reservedQuantity Int      @default(0) @map("reserved_quantity")
  updatedAt        DateTime @updatedAt @map("updated_at")

  product Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

model PriceGroup {
  id        String           @id @default(cuid())
  name      String           @unique
  slug      String           @unique
  status    PriceGroupStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  customers Customer[]
  prices    Price[]

  @@map("price_groups")
}

model Price {
  id           String    @id @default(cuid())
  productId    String    @map("product_id")
  variantId    String?   @map("variant_id")
  priceGroupId String    @map("price_group_id")
  amount       Decimal   @db.Decimal(12, 2)
  currency     String    @default("USD") @db.VarChar(3)
  activeFrom   DateTime? @map("active_from")
  activeTo     DateTime? @map("active_to")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  priceGroup PriceGroup      @relation(fields: [priceGroupId], references: [id], onDelete: Restrict)

  @@index([productId, priceGroupId])
  @@index([variantId, priceGroupId])
  @@index([priceGroupId])
  @@map("prices")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  oldData    Json?    @map("old_data")
  newData    Json?    @map("new_data")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MANUAL
}

model Address {
  id         String   @id @default(cuid())
  customerId String   @map("customer_id")
  label      String?
  recipient  String
  phone      String?
  line1      String
  line2      String?
  city       String
  region     String?
  postalCode String?  @map("postal_code")
  country    String   @default("SA")
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@index([customerId, isDefault])
  @@map("addresses")
}

model Cart {
  id         String     @id @default(cuid())
  customerId String     @map("customer_id")
  status     CartStatus @default(ACTIVE)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  customer Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CartItem[]
  order    Order?

  @@index([customerId, status])
  @@map("carts")
}

model CartItem {
  id         String   @id @default(cuid())
  cartId     String   @map("cart_id")
  productId  String   @map("product_id")
  variantId  String?  @map("variant_id")
  variantKey String   @default("") @map("variant_key")
  quantity   Int
  unitPrice  Decimal  @map("unit_price") @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId, variantKey])
  @@index([productId])
  @@index([variantId])
  @@map("cart_items")
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique @map("order_number")
  customerId      String        @map("customer_id")
  cartId          String?       @unique @map("cart_id")
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING) @map("payment_status")
  subtotal        Decimal       @db.Decimal(12, 2)
  discount        Decimal       @default(0) @db.Decimal(12, 2)
  shipping        Decimal       @default(0) @db.Decimal(12, 2)
  tax             Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  currency        String        @default("USD") @db.VarChar(3)
  addressId       String?       @map("address_id")
  shippingName    String        @map("shipping_name")
  shippingPhone   String?       @map("shipping_phone")
  shippingLine1   String        @map("shipping_line1")
  shippingLine2   String?       @map("shipping_line2")
  shippingCity    String        @map("shipping_city")
  shippingRegion  String?       @map("shipping_region")
  shippingPostal  String?       @map("shipping_postal")
  shippingCountry String        @map("shipping_country")
  customerNotes   String?       @map("customer_notes")
  adminNotes      String?       @map("admin_notes")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  customer Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  cart     Cart?                @relation(fields: [cartId], references: [id], onDelete: SetNull)
  address  Address?             @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  history  OrderStatusHistory[]
  payments Payment[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String   @map("order_id")
  productId           String?  @map("product_id")
  variantId           String?  @map("variant_id")
  productName         String   @map("product_name")
  variantName         String?  @map("variant_name")
  sku                 String
  attributesSnapshot  Json?    @map("attributes_snapshot")
  quantity            Int
  unitPrice           Decimal  @map("unit_price") @db.Decimal(12, 2)
  total               Decimal  @db.Decimal(12, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String       @map("order_id")
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  changedBy  String?      @map("changed_by")
  notes      String?
  createdAt  DateTime     @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String        @map("order_id")
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod
  status    PaymentStatus @default(PENDING)
  reference String?
  paidAt    DateTime?     @map("paid_at")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
  @@map("payments")
}

model Attribute {
  id        String        @id @default(cuid())
  name      String
  slug      String        @unique
  type      AttributeType
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  values            AttributeValue[]
  productAttributes ProductAttribute[]

  @@map("attributes")
}

model AttributeValue {
  id          String  @id @default(cuid())
  attributeId String  @map("attribute_id")
  value       String
  slug        String
  colorHex    String? @map("color_hex")
  sortOrder   Int     @default(0) @map("sort_order")

  attribute     Attribute                @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variantValues VariantAttributeValue[]
  allowedOn     ProductAllowedValue[]

  @@unique([attributeId, slug])
  @@index([attributeId, sortOrder])
  @@map("attribute_values")
}

model ProductAttribute {
  productId   String @map("product_id")
  attributeId String @map("attribute_id")
  sortOrder   Int    @default(0) @map("sort_order")

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([productId, attributeId])
  @@index([attributeId])
  @@map("product_attributes")
}

model ProductAllowedValue {
  productId        String @map("product_id")
  attributeValueId String @map("attribute_value_id")

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  value   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([productId, attributeValueId])
  @@index([attributeValueId])
  @@map("product_allowed_values")
}

model ProductVariant {
  id              String        @id @default(cuid())
  productId       String        @map("product_id")
  sku             String        @unique
  name            String
  status          VariantStatus @default(ACTIVE)
  weight          Decimal?      @db.Decimal(10, 3)
  combinationKey  String        @map("combination_key")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  product    Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  values     VariantAttributeValue[]
  inventory  Inventory?
  prices     Price[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, combinationKey])
  @@index([productId, status])
  @@map("product_variants")
}

model VariantAttributeValue {
  variantId        String @map("variant_id")
  attributeValueId String @map("attribute_value_id")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  value   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Restrict)

  @@id([variantId, attributeValueId])
  @@index([attributeValueId])
  @@map("variant_attribute_values")
}

model DisplayCurrency {
  id          String   @id @default(cuid())
  code        String   @unique @db.VarChar(3)
  label       String
  symbol      String
  rateFromUsd Decimal  @map("rate_from_usd") @db.Decimal(18, 8)
  locale      String   @default("en-US")
  isBase      Boolean  @default(false) @map("is_base")
  status      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status, sortOrder])
  @@map("display_currencies")
}
